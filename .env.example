# AI Provider Configuration (supports OpenAI and Google Gemini)
# AI_PROVIDER=openai # Options: 'openai' or 'gemini' (defaults to whichever key is provided)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini # Options: 'gpt-4o', 'gpt-4o-mini'

# Google Gemini API Key (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ngrok Configuration (optional)
ENABLE_NGROK=false
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# Security & Network Configuration (optional)
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SYNC_API_KEY=
